{
  "name": "har-inspector-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension for local HAR analysis and response/resource inspection",
  "scripts": {
    "build": "webpack --mode production && cp manifest.json background.js dist/ && cp -R icons dist/icons",
    "test": "node --test src/*.test.js",
    "dev": "webpack --mode development",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-tiny-virtual-list": "^2.2.0",
    "react-virtualized": "^9.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  }
}
